---
import '../styles/global.css';
import { projekt } from '@/projekt.config';
import { grundgeruest } from '@/lib/schema';

// Schriften vorab laden (schnellerer Seitenaufbau): welche, steht in src/projekt.config.ts (schriftenVorladen)
const schriftDateien = import.meta.glob<string>('/src/assets/fonts/*.woff2', { eager: true, query: '?url', import: 'default' });
const schriftenVorladen = ((projekt as { schriftenVorladen?: readonly string[] }).schriftenVorladen ?? [])
  .map((name) => schriftDateien[`/src/assets/fonts/${name}`])
  .filter(Boolean);

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Nur für Seiten, die nicht in Google erscheinen sollen (404). Alle anderen Seiten bleiben indexierbar. */
  noindex?: boolean;
  /**
   * Entwurf (Schalter „Veröffentlicht“ aus): Die Seite wird nach dem Build aus der Website entfernt
   * (src/integrations/entwuerfe.mjs); eine Vorschau gibt es nur im CMS für angemeldete Personen.
   */
  entwurf?: boolean;
  /** Sprache der Seite (z. B. 'it' oder 'en' bei mehrsprachigen Websites). Standard: Deutsch */
  lang?: string;
  /**
   * Für Beiträge und Projekte: Datum der Veröffentlichung bzw. Überarbeitung.
   * Social-Media-Vorschauen zeigen die Seite dann als Artikel mit Datum.
   */
  artikel?: { veroeffentlicht?: Date | string; geaendert?: Date | string };
}

const { title, description, image = '/default-og.jpg', noindex = false, entwurf = false, lang = 'de', artikel } = Astro.props;
const isoDatum = (d?: Date | string) => (d ? new Date(d).toISOString() : undefined);
const artikelVeroeffentlicht = isoDatum(artikel?.veroeffentlicht);
const artikelGeaendert = isoDatum(artikel?.geaendert) ?? artikelVeroeffentlicht;
const ogLocale = ({ de: 'de_DE', it: 'it_IT', en: 'en_GB', fr: 'fr_FR' } as Record<string, string>)[lang] ?? 'de_DE';
const sprungText = ({ de: 'Zum Inhalt springen', it: 'Vai al contenuto', en: 'Skip to content', fr: 'Aller au contenu' } as Record<string, string>)[lang] ?? 'Zum Inhalt springen';
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://example.com');
const ogBild = new URL(image, Astro.site || Astro.url).href;
// Strukturierte Daten: Website, Unternehmen und diese Seite (verknüpft, siehe src/lib/schema.ts).
// „zuletzt geändert“ trägt src/integrations/sitemap.mjs nach dem Build ein.
const schemaGrundgeruest = grundgeruest(Astro.site || Astro.url, {
  url: canonicalURL.href,
  titel: title,
  beschreibung: description,
  lang,
  bild: ogBild,
});
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {schriftenVorladen.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Merker „JavaScript läuft“ – Einblende-Effekte verstecken Inhalte nur dann (sonst bleibt alles sichtbar) -->
  <script is:inline>document.documentElement.classList.add('js');</script>

  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  {entwurf ? <meta name="ms-entwurf" content="ja" /> : <link rel="canonical" href={canonicalURL} />}

  <!-- Open Graph / Facebook / LinkedIn -->
  <meta property="og:type" content={artikel ? 'article' : 'website'} />
  <meta property="og:site_name" content={projekt.firmenname} />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogBild} />
  <meta property="og:locale" content={ogLocale} />
  <meta name="twitter:card" content="summary_large_image" />
  {artikelVeroeffentlicht && <meta property="article:published_time" content={artikelVeroeffentlicht} />}
  {artikelGeaendert && <meta property="article:modified_time" content={artikelGeaendert} />}

  <!-- Sitemap für Suchmaschinen -->
  {!entwurf && <link rel="sitemap" href="/sitemap.xml" />}

  <!-- Strukturierte Daten: Website, Unternehmen, Seite (nicht auf 404- und noindex-Seiten) -->
  {!noindex && <script type="application/ld+json" data-ms-grundgeruest set:html={JSON.stringify(schemaGrundgeruest)} />}

  <!-- Seitenspezifische Ergänzungen im <head> (z. B. JSON-LD) -->
  <slot name="head" />

  <!-- Robots & AI Crawlability -->
  <meta
    name="robots"
    content={
      entwurf
        ? 'noindex, nofollow'
        : noindex
          ? 'noindex, follow'
          : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
    }
  />
</head>
<body class="bg-white text-slate-900 antialiased min-h-screen flex flex-col">
  <!-- Barrierefreiheit: Tastaturnutzer können die Navigation überspringen -->
  <a href="#inhalt" class="skip-link sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:font-semibold focus:text-slate-900 focus:shadow-lg">
    {sprungText}
  </a>
  <slot name="header" />
  <!-- tabindex="-1": Der Sprunglink setzt den Fokus wirklich in den Inhalt (auch in Safari) -->
  <main id="inhalt" tabindex="-1" class="flex-grow">
    <slot />
  </main>
  <slot name="footer" />

  <!-- Barrierefreie Bewegung: Daueranimationen enden nach max. 5 s sanft, „Bewegung reduzieren“ wird beachtet,
       Hilfen data-bewegung, .einblenden, data-woerter, data-zahl, data-parallax (siehe src/lib/bewegung.ts) -->
  <script>
    import { bewegungStarten } from '@/lib/bewegung';
    bewegungStarten();
  </script>
</body>
</html>
