---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Nur für Seiten, die nicht in Google erscheinen sollen (404). Alle anderen Seiten bleiben indexierbar. */
  noindex?: boolean;
  /**
   * Entwurf (Schalter „Veröffentlicht“ aus): Die Seite wird nach dem Build aus der Website entfernt
   * (src/integrations/entwuerfe.mjs); eine Vorschau gibt es nur im CMS für angemeldete Personen.
   */
  entwurf?: boolean;
}

const { title, description, image = '/default-og.jpg', noindex = false, entwurf = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://example.com');
---

<!DOCTYPE html>
<html lang="de" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Merker „JavaScript läuft“ – Einblende-Effekte verstecken Inhalte nur dann (sonst bleibt alles sichtbar) -->
  <script is:inline>document.documentElement.classList.add('js');</script>

  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  {entwurf ? <meta name="ms-entwurf" content="ja" /> : <link rel="canonical" href={canonicalURL} />}

  <!-- Open Graph / Facebook / LinkedIn -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site || Astro.url)} />
  <meta property="og:locale" content="de_DE" />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- Sitemap für Suchmaschinen -->
  {!entwurf && <link rel="sitemap" href="/sitemap.xml" />}

  <!-- Seitenspezifische Ergänzungen im <head> (z. B. JSON-LD) -->
  <slot name="head" />

  <!-- Robots & AI Crawlability -->
  <meta
    name="robots"
    content={
      entwurf
        ? 'noindex, nofollow'
        : noindex
          ? 'noindex, follow'
          : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
    }
  />
</head>
<body class="bg-white text-slate-900 antialiased min-h-screen flex flex-col">
  <!-- Barrierefreiheit: Tastaturnutzer können die Navigation überspringen -->
  <a href="#inhalt" class="skip-link sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:font-semibold focus:text-slate-900 focus:shadow-lg">
    Zum Inhalt springen
  </a>
  <slot name="header" />
  <!-- tabindex="-1": Der Sprunglink setzt den Fokus wirklich in den Inhalt (auch in Safari) -->
  <main id="inhalt" tabindex="-1" class="flex-grow">
    <slot />
  </main>
  <slot name="footer" />

  <!-- Barrierefreie Bewegung: Daueranimationen enden nach max. 5 s sanft, „Bewegung reduzieren“ wird beachtet,
       Hilfen data-bewegung, .einblenden, data-woerter, data-zahl, data-parallax (siehe src/lib/bewegung.ts) -->
  <script>
    import { bewegungStarten } from '@/lib/bewegung';
    bewegungStarten();
  </script>
</body>
</html>
