---
/**
 * Ein Termin in der Liste (Übersicht und Startseiten-Vorschau).
 * Aussehen pro Kunde anpassbar. Props, data-endet-um und data-tags bitte beibehalten
 * (damit rutschen vergangene Termine auch ohne neuen Build automatisch nach unten).
 */
import { Image } from 'astro:assets';
import { tagKennung, zeitISO, type Eintrag } from '@/lib/bausteine';

interface Props {
  eintrag: Eintrag;
  stufe?: 'h2' | 'h3';
}

const { eintrag: e, stufe = 'h2' } = Astro.props;
const t = e.termin!;
const Ueberschrift = stufe;
const monat = new Date(Date.UTC(t.beginn.jahr, t.beginn.monat - 1, 1)).toLocaleDateString('de-DE', {
  month: 'short',
  timeZone: 'UTC',
});
const ort = e.daten.online ? 'Online' : e.daten.ortName;
---

<article
  class="group relative flex gap-5 rounded-xl border border-slate-200 bg-white p-5 transition hover:shadow-lg has-[:focus-visible]:ring-[3px] has-[:focus-visible]:ring-brand has-[:focus-visible]:ring-offset-2"
  data-termin
  data-endet-um={t.endetUm.toISOString()}
  data-tags={e.tags.map(tagKennung).join(' ')}
>
  <div
    class="flex h-20 w-20 shrink-0 flex-col items-center justify-center rounded-lg bg-brand-light text-brand-dark"
    aria-hidden="true"
  >
    <span class="text-2xl font-bold leading-none">{t.beginn.tag}</span>
    <span class="mt-1 text-sm uppercase">{monat}</span>
  </div>
  <div class="flex min-w-0 flex-1 flex-col gap-1">
    <p class="text-sm text-slate-600">
      <time datetime={zeitISO(t.beginn, t.ganztaegig)}>{t.text}</time>
      {ort && <span> · {ort}</span>}
    </p>
    <Ueberschrift class="text-lg font-semibold leading-snug text-slate-900">
      <a href={e.url} class="after:absolute after:inset-0 focus:outline-none">{e.titel}</a>
    </Ueberschrift>
    {t.abgesagt && <p class="w-fit rounded bg-red-50 px-2 py-0.5 text-sm font-semibold text-red-800">Abgesagt</p>}
    {e.kurztext && <p class="text-slate-600">{e.kurztext}</p>}
  </div>
  {
    e.titelbild && (
      <Image
        src={e.titelbild}
        alt=""
        width={240}
        height={180}
        format="webp"
        class="hidden h-[90px] w-[120px] shrink-0 rounded-lg object-cover sm:block"
      />
    )
  }
</article>
