---
/**
 * PLATZHALTER-Fußbereich – wird pro Kunde durch den eigenen Footer im Kundendesign ersetzt.
 * Wird von den Starter-Seiten eingebunden, deshalb muss es diese Datei immer geben.
 * Der Footer enthält immer Links zu /impressum und /datenschutz.
 */
import { projekt } from '@/projekt.config';
const jahr = new Date().getFullYear();
---

<footer class="mt-16 border-t border-slate-200">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-8 text-sm text-slate-600">
    <p>© {jahr} {projekt.firmenname}</p>
    <nav aria-label="Rechtliches">
      <ul class="flex gap-6">
        <li><a href="/impressum" class="hover:text-brand">Impressum</a></li>
        <li><a href="/datenschutz" class="hover:text-brand">Datenschutz</a></li>
      </ul>
    </nav>
  </div>
</footer>
