---
/**
 * Barrierefreies Kontaktformular für den zentralen Formular-Hub
 * (https://forms.millionstories.de/).
 *
 * Verwendung:
 *   import Kontaktformular from '@/components/Kontaktformular.astro';
 *   <Kontaktformular kundeId="muster-gmbh" />
 *
 * kundeId und formType müssen exakt mit dem Eintrag in der index.php
 * des Hubs übereinstimmen. Für weitere Formulartypen (z. B. Bewerbung)
 * diese Komponente kopieren und Felder anpassen.
 *
 * Barrierefrei (WCAG 2.2 AA): sichtbare Beschriftungen, Feldrahmen mit 3:1 Kontrast,
 * Fehlermeldungen direkt am Feld (src/lib/formular-pruefung.ts), Statusmeldung per aria-live.
 * Auf dunklem Hintergrund: Formular in einen Bereich mit class="auf-dunkel" setzen.
 */
interface Props {
  kundeId: string;
  formType?: string;
  datenschutzUrl?: string;
  buttonText?: string;
}

const {
  kundeId,
  formType = 'kontakt',
  datenschutzUrl = '/datenschutz',
  buttonText = 'Nachricht senden',
} = Astro.props;

// Eindeutige IDs, falls mehrere Formulare auf einer Seite stehen
const id = `formular-${formType}`;

const feldKlassen =
  'mt-1 block w-full rounded-lg border border-slate-500 bg-white px-4 py-3 text-base text-slate-900 ' +
  'placeholder:text-slate-500 focus:border-brand';
---

<form
  id={id}
  class="relative space-y-5"
  aria-label="Kontaktformular"
  data-formhub
  data-kunde-id={kundeId}
  data-form-type={formType}
>
  <p class="text-sm text-slate-600">Pflichtfelder sind mit <span aria-hidden="true">*</span><span class="sr-only">Sternchen</span> markiert.</p>

  <div>
    <label for={`${id}-name`} class="block text-sm font-medium text-slate-800">
      Name <span aria-hidden="true">*</span>
    </label>
    <input id={`${id}-name`} name="name" type="text" autocomplete="name" required data-fehler="Bitte geben Sie Ihren Namen ein." class={feldKlassen} />
  </div>

  <div>
    <label for={`${id}-email`} class="block text-sm font-medium text-slate-800">
      E-Mail-Adresse <span aria-hidden="true">*</span>
    </label>
    <input id={`${id}-email`} name="email" type="email" autocomplete="email" required data-fehler="Bitte geben Sie eine gültige E-Mail-Adresse ein, z. B. name@beispiel.de." class={feldKlassen} />
  </div>

  <div>
    <label for={`${id}-telefon`} class="block text-sm font-medium text-slate-800">
      Telefon <span class="font-normal text-slate-500">(optional)</span>
    </label>
    <input id={`${id}-telefon`} name="telefon" type="tel" autocomplete="tel" class={feldKlassen} />
  </div>

  <div>
    <label for={`${id}-nachricht`} class="block text-sm font-medium text-slate-800">
      Ihre Nachricht <span aria-hidden="true">*</span>
    </label>
    <textarea id={`${id}-nachricht`} name="nachricht" rows="6" required data-fehler="Bitte schreiben Sie uns Ihre Nachricht." class={feldKlassen}></textarea>
  </div>

  <div class="flex items-start gap-3">
    <input
      id={`${id}-datenschutz`}
      name="datenschutz"
      type="checkbox"
      value="Zugestimmt"
      required
      data-fehler="Bitte stimmen Sie der Verarbeitung Ihrer Angaben zu."
      class="mt-0.5 h-6 w-6 shrink-0 rounded border-slate-500 accent-brand"
    />
    <label for={`${id}-datenschutz`} class="text-sm text-slate-700">
      Ich habe die <a href={datenschutzUrl} class="font-medium text-brand underline underline-offset-2 hover:text-brand-dark">Datenschutzerklärung</a>
      gelesen und bin mit der Verarbeitung meiner Angaben zur Beantwortung meiner Anfrage einverstanden. <span aria-hidden="true">*</span>
    </label>
  </div>

  <!-- Honeypot: für Menschen unsichtbar, Bots füllen es aus. Nicht entfernen. -->
  <div class="absolute -left-[9999px]" aria-hidden="true">
    <label for={`${id}-hp`}>Bitte leer lassen</label>
    <input type="text" id={`${id}-hp`} name="_honeypot" tabindex="-1" autocomplete="off" />
  </div>

  <button
    type="submit"
    class="inline-flex items-center justify-center rounded-lg bg-brand px-6 py-3 font-semibold text-white transition hover:bg-brand-dark focus-visible:outline-offset-4 disabled:cursor-wait disabled:opacity-60"
  >
    {buttonText}
  </button>

  <p data-formhub-status role="status" aria-live="polite"></p>
</form>

<script>
  import { verbindeFormular } from '@/lib/formhub-client.js';
  import { formularPruefen } from '@/lib/formular-pruefung';

  // Verbindet alle Hub-Formulare der Seite (auch mehrere) genau einmal
  document.querySelectorAll<HTMLFormElement>('form[data-formhub]').forEach((form) => {
    if (form.dataset.formhubVerbunden) return;
    form.dataset.formhubVerbunden = 'true';
    // Zuerst: Fehler am Feld anzeigen und den Versand anhalten, bis alles stimmt
    formularPruefen(form);
    verbindeFormular(form, {
      kundeId: form.dataset.kundeId,
      formType: form.dataset.formType,
    });
  });
</script>
