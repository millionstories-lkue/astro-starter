---
// Fehlerseite. Diese Datei nicht verändern (Firmenname kommt aus src/projekt.config.ts).
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { projekt } from '@/projekt.config';
---

<BaseLayout title={`Seite nicht gefunden | ${projekt.firmenname}`} description="Die angeforderte Seite wurde nicht gefunden.">
  <Header slot="header" />
  <section class="mx-auto max-w-2xl px-6 py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand">Fehler 404</p>
    <h1 class="mt-4 text-3xl font-bold text-slate-900">Diese Seite gibt es leider nicht</h1>
    <p class="mt-4 text-slate-600">Vielleicht hat sich die Adresse geändert oder es liegt ein Tippfehler vor.</p>
    <a href="/" class="mt-8 inline-flex rounded-lg bg-brand px-6 py-3 font-semibold text-white hover:bg-brand-dark">
      Zur Startseite
    </a>
  </section>
  <Footer slot="footer" />
</BaseLayout>
