---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<!-- Platzhalter-Startseite – wird im Kundenprojekt durch den finalen Entwurf ersetzt -->
<BaseLayout
  title="Neue Webseite | Kundenname"
  description="Hier entsteht die neue Webseite."
>
  <section class="mx-auto max-w-3xl px-6 py-24 text-center">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900">Hier entsteht eine neue Webseite</h1>
    <p class="mt-6 text-lg text-slate-600">Wir sind bald für Sie da.</p>
  </section>
</BaseLayout>
